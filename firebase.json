{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "reiseapp-mamatocherontour",
          "appId": "1:85269677127:android:89af600ec4bfa8df9a1d62",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "reiseapp-mamatocherontour",
          "appId": "1:85269677127:ios:9ae6aaac2af69a9d9a1d62",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "reiseapp-mamatocherontour",
          "configurations": {
            "android": "1:85269677127:android:89af600ec4bfa8df9a1d62",
            "ios": "1:85269677127:ios:9ae6aaac2af69a9d9a1d62"
          }
        }
      }
    }
  },
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions"
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "firestore": {
      "port": 8080
    }
  }
}
