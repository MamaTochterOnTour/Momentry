  "romPageTitle": "Rome",
  "romDescriptionTitle": "🏛 Rome – Historical Capital of Italy",
  "romDescription": "Rome fascinates with ancient buildings, historic squares, winding streets, world-famous museums, and vibrant Italian cuisine. The city offers countless opportunities for sightseeing, culture, shopping, and enjoyment.",
  "sightsAndActivitiesTitle": "🏛 Sights & Activities",
  "colosseum": "Colosseum",
  "colosseumDescription": "The world-famous amphitheater, known for gladiator fights and ancient architecture. Good-to-Know: Allow enough time to also enter the interior and explore the underground areas.",
  "forumRomanum": "Roman Forum",
  "forumRomanumDescription": "Archaeological heart of Rome with ruins of ancient temples, administrative buildings, and triumphal arches. Tip: Visit early morning or late afternoon to avoid crowds and take great photos.",
  "pantheon": "Pantheon",
  "pantheonDescription": "Ancient temple, now a church, with an impressive dome and large opening in the roof. Good-to-Know: Entry is free, but dress appropriately.",
  "vatican": "St. Peter's Basilica & Vatican",
  "vaticanDescription": "Highlights for art and culture lovers: St. Peter's Basilica, Sistine Chapel, and Vatican Museums. Good-to-Know: Going up the dome can be narrow and steep; allow time for the ascent.",
  "treviFountain": "Trevi Fountain",
  "treviFountainDescription": "Famous fountain where visitors throw coins for luck and return. Tip: Visit early morning for photos without crowds.",
  "piazzaNavona": "Piazza Navona",
  "piazzaNavonaDescription": "Baroque square with fountains, street cafés, and lively atmosphere. Insider Tip: In the back alleys around the piazza, there are small authentic cafés away from tourists.",
  "spanishSteps": "Spanish Steps",
  "spanishStepsDescription": "Popular meeting point, perfect for strolling, photographing, and people-watching. Good-to-Know: Early morning is less crowded with optimal light for photos.",
  "palatineHill": "Palatine Hill",
  "palatineHillDescription": "Historic hill where Roman emperors lived, with ruins and fantastic views over the Roman Forum and Circus Maximus. Tip: Combine with the Roman Forum visit — tickets often cover both.",
  "keyhole": "Keyhole (Buco della Serratura)",
  "keyholeDescription": "Secret highlight in Aventine: The keyhole perfectly frames St. Peter's Basilica — great photo spot away from crowds. Insider Tip: Early morning or late afternoon is quiet.",
  "trastevere": "Trastevere",
  "trastevereDescription": "Charming district with cobblestones, traditional restaurants, bars, and lively atmosphere. Good-to-Know: Very lively in the evenings; streets can be narrow — watch out for bikes and scooters!",
  "orangeGarden": "Giardino degli Aranci (Orange Garden)",
  "orangeGardenDescription": "Quiet garden with panoramic city views — a relaxed insider spot away from the crowds. Tip: Sunset is especially photogenic.",
  "coppede": "Coppedè Quarter",
  "coppedeDescription": "Playful Art Nouveau architecture, hidden squares, and fascinating details — a real tip for architecture fans. Good-to-Know: Best explored with a camera; few tourists here.",
  "santaMariaTrastevere": "Basilica Santa Maria in Trastevere",
  "santaMariaTrastevereDescription": "Less visited than the major churches, but beautiful with impressive mosaics and relaxed atmosphere. Tip: Visit in the morning for calmness.",
  "culinaryTitle": "🍽 Culinary & Food Tips",
  "gelateria": "🍦 Gelateria del Teatro",
  "gelateriaDescription": "Traditional gelato shop in Rome with creative, handmade flavors — perfect for a sweet break while exploring the old town.",
  "laTavernetta": "🍝 La Tavernetta 29 Da Tony e Andrea",
  "laTavernettaDescription": "Cozy family-run Roman restaurant in Trastevere with classic pasta dishes, antipasti, and authentic Italian atmosphere.",
  "fontanaBakery": "🥖 L'Antico Forno di Fontana di Trevi",
  "fontanaBakeryDescription": "Popular bakery right by the Trevi Fountain — ideal for fresh bread, pizza slices, and sweet treats on the go.",
  "roscioli": "🍷 Roscioli Salumeria con Cucina",
  "roscioliDescription": "Legendary Roman delicatessen and kitchen near Campo de’ Fiori — famous for excellent pasta, antipasti, cheese, wine, and Roman specialties.",
  "streetPizza": "🍕 Street-Food Tip: Pizza al taglio",
  "streetPizzaDescription": "Quick and tasty: Pizza al taglio (by the slice) is found all over Rome — perfect for standing and enjoying while sightseeing. Local favorites include SPIZZICA ROMA, Alice Pizza, and Pizza A Taglio.",
  "hotelsTitle": "🏨 Hotels & Accommodation",
  "hotelBolivar": "Hotel Bolivar – Trevi Fountain",
  "hotelBolivarDescription": "Centrally located hotel near Trevi Fountain, ideal for sightseeing and city tours.",
  "arrivalTitle": "🚢 Arrival & Tips",
  "flightTrain": "Flight & Train",
  "flightTrainDescription": "Rome is easily accessible by plane. From Fiumicino Airport, take the Leonardo Express or taxi to the city center.",
  "carParking": "Car & Parking",
  "carParkingDescription": "Rome can also be explored by car. Downtown parking is limited, so central parking garages are recommended.",
  "becomePartnerText": "Would you also like to become a partner? Feel free to contact us at {email}",
